{
  "name": "cleetus",
  "version": "0.5.6",
  "description": "Local-first agentic coding assistant for llama.cpp, LM Studio, and Ollama.",
  "license": "MIT",
  "author": "Common Cosmo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/commoncosmo/cleetus.git"
  },
  "homepage": "https://github.com/commoncosmo/cleetus#readme",
  "bugs": {
    "url": "https://github.com/commoncosmo/cleetus/issues"
  },
  "packageManager": "bun@1.3.14",
  "type": "module",
  "bin": {
    "cleetus": "src/bin/cleetus.ts"
  },
  "scripts": {
    "test": "bun test",
    "lint": "biome check src tests",
    "format": "biome format --write src tests",
    "typecheck": "bunx tsc --noEmit",
    "build": "bun run scripts/build.ts",
    "licenses": "bun run scripts/generate-third-party-notices.ts",
    "licenses:check": "bun run scripts/generate-third-party-notices.ts --check",
    "install-local": "bun run build && bun run scripts/install.ts",
    "smoke:editor": "bun run scripts/smoke-editor.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "ajv": "8.20.0",
    "commander": "12.1.0",
    "ink": "5.2.1",
    "jimp": "1.6.1",
    "lowlight": "3.3.0",
    "marked": "18.0.4",
    "node-html-markdown": "2.0.0",
    "react": "18.3.1",
    "string-width": "7.2.0",
    "ulid": "2.4.0",
    "yaml": "2.9.0",
    "zod": "3.25.76"
  },
  "overrides": {
    "@hono/node-server": "1.19.15",
    "body-parser": "2.3.0",
    "fast-uri": "3.1.6",
    "hono": "4.13.5",
    "ip-address": "10.3.1",
    "qs": "6.16.0"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@types/bun": "1.3.14",
    "@types/react": "18.3.29",
    "react-devtools-core": "file:./scripts/stubs/react-devtools-core",
    "typescript": "5.9.3"
  },
  "engines": {
    "bun": "1.3.14"
  }
}
